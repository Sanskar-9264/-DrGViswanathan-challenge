class Solution {
public:

    bool isalphanum(char ch){
        if((ch>='0' && ch<='9') || (tolower(ch)>= 'a' && tolower(ch)<='z')){
            return true;
        }
         return false;
    }

    bool isPalindrome(string s) {
        int st = 0 ; 
        int end = s.size() -1 ;

        while(st<end){
            if(! isalphanum(s[st])){
                st++;
                continue;
            }
            if(!isalphanum(s[end])){
                end--;
                continue;
            }
            if(tolower(s[st]) != tolower(s[end])){
                return false;
            }
            st++;
            end--;
        }
        return true;
    } 
};


